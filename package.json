{
  "name": "dsh-message-rewind",
  "version": "0.1.0",
  "type": "module",
  "description": "Withdraw a message you just sent in the DSH conversation: stop the running answer, put its text back in the composer, and leave the row marked as withdrawn.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "withdraw",
    "rewind"
  ],
  "homepage": "https://github.com/mio-4396/dsh-message-rewind#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mio-4396/dsh-message-rewind.git"
  },
  "bugs": {
    "url": "https://github.com/mio-4396/dsh-message-rewind/issues"
  },
  "author": "mio-4396",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --test tests/manifest.test.mjs",
    "check": "node scripts/build.mjs && node --check lib/index.js && node --check lib/client.js"
  },
  "icon": "./icon.svg",
  "license": "MIT",
  "engines": {
    "dsh": ">=0.2.0 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  }
}
